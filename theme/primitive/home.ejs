<h1 class="visually-hidden" lang="en">Posts</h1>
<ul class="post-list">
  <% for (const post of posts) { %>
    <li>
      <a href="<%= url(post.url) %>">
        <time datetime="<%= post.date %>"><%= post.date %></time>
        <span><%= post.title %></span>
      </a>
      <% if (post.tags.length) { %>
        <ul class="tags" aria-label="Tags">
          <% for (const tag of post.tags) { %><li><%= tag %></li><% } %>
        </ul>
      <% } %>
    </li>
  <% } %>
</ul>
