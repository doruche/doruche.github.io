<p class="links">
  <% for(let item of theme.link){ %>
    <a title="<%- item.name %>" target="<%- item.target -%>" href="<%- item.path %>">
      <% if (item.icon === 'bilibili') { %>
        <svg class="social-icon social-icon-bilibili" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8.5 4.5 6.2 2.2M15.5 4.5l2.3-2.3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <rect x="3" y="5.5" width="18" height="15" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <path d="M8 11.5v3M16 11.5v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      <% } else { %>
        <i class="iconfont icon-<%- item.icon %>"></i>
      <% } %>
    </a>
  <% } %>
</p>
