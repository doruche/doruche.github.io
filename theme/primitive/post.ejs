<article>
  <header class="post-header">
    <p class="meta">
      <time datetime="<%= post.date %>"><%= post.date %></time>
      <% if (post.tags.length) { %>
        <span class="tags" aria-label="Tags">
          <% for (const tag of post.tags) { %><span><%= tag %></span><% } %>
        </span>
      <% } %>
    </p>
    <h1><%= post.title %></h1>
  </header>
  <% if (post.sections.length >= 3) { %>
    <nav class="toc" aria-labelledby="toc-title">
      <p class="toc-title" id="toc-title" lang="en">Contents</p>
      <ol>
        <% for (const section of post.sections) { %>
          <li><a href="#<%= section.id %>"><span class="toc-number">§<%= section.number %></span><span class="toc-text"><%= section.title %></span></a></li>
        <% } %>
      </ol>
    </nav>
  <% } %>
  <div class="prose"><%- post.html %></div>
</article>
<% if (newer || older) { %>
  <nav class="neighbors" aria-label="More posts">
    <% if (newer) { %>
      <a href="<%= url(newer.url) %>"><span lang="en">← Newer</span><%= newer.title %></a>
    <% } %>
    <% if (older) { %>
      <a class="older" href="<%= url(older.url) %>"><span lang="en">Older →</span><%= older.title %></a>
    <% } %>
  </nav>
<% } %>
