<!doctype html>
<html lang="<%= site.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="author" content="<%= site.author.name %>">
  <title><%= title %></title>
  <link rel="canonical" href="<%= canonical %>">
  <link rel="icon" href="<%= url('/assets/favicon.png') %>">
  <link rel="stylesheet" href="<%= url('/theme/primitive/style.css') %>">
</head>
<body>
  <a class="skip-link" href="#main" lang="en">Skip to content</a>
  <header class="masthead">
    <a class="site-title" href="<%= url('/') %>"><%= site.title %></a>
    <nav aria-label="Site" lang="en">
      <a class="text-link" href="<%= url('/archives/') %>"<%- route === '/archives/' ? ' aria-current="page"' : '' %>>Archive</a>
      <% for (const page of pages) { %>
        <a class="text-link" href="<%= url(page.url) %>"<%- route === page.url ? ' aria-current="page"' : '' %>><%= page.title %></a>
      <% } %>
      <% if (site.author.links.length) { %>
        <span class="nav-divider" aria-hidden="true"></span>
      <% } %>
      <% for (const link of site.author.links) { %>
        <a class="icon-link" href="<%= link.url %>" aria-label="<%= link.label %>">
          <%- include('icons/' + link.icon + '.svg') %>
          <span aria-hidden="true"><%= link.label %></span>
        </a>
      <% } %>
    </nav>
  </header>
  <main id="main"><%- body %></main>
  <footer class="colophon" lang="en">© <%= year %> <%= site.author.name %></footer>
</body>
</html>
