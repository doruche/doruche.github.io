<% const count = years.reduce((total, group) => total + group.posts.length, 0); %>
<header class="post-header" lang="en">
  <p class="meta"><span><%= count %> <%= count === 1 ? 'post' : 'posts' %></span></p>
  <h1>Archive</h1>
</header>
<% for (const group of years) { %>
  <section class="archive">
    <h2><%= group.year %></h2>
    <ul class="archive-list">
      <% for (const post of group.posts) { %>
        <li>
          <time datetime="<%= post.date %>"><%= post.date.slice(5) %></time>
          <a href="<%= url(post.url) %>"><%= post.title %></a>
        </li>
      <% } %>
    </ul>
  </section>
<% } %>
